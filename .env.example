# Copy to your host's environment settings. None are required to run locally.
PORT=3000
# Where the SQLite database and uploaded photos live. Must be persistent storage in production.
DATA_DIR=./data
# Public URL used in emails and calendar links, e.g. https://theshoppeatcastle.com
PUBLIC_URL=
# Optional: temporary password for the first-run staff accounts (otherwise random and printed to the log).
SEED_PASSWORD=
# Optional: send confirmation/cancellation emails via Resend (https://resend.com).
RESEND_API_KEY=
MAIL_FROM="The Shoppe at Castle <bookings@yourdomain.com>"
